---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// Tag-filtered views are client-side only; keep the canonical page indexable.
const hasTagParam = Astro.url.searchParams.has("tag");
---

<BaseLayout
  title="Writing"
  description="Notes on software development, backend architecture, and building for the web — by Afghan Eka Pangestu, software developer in Bogor, Indonesia."
  ogImage="/og/site.png"
  noindex={hasTagParam}
>
  <Header />

  <main id="main-content" class="flex-1" data-pagefind-body>
    <!-- Masthead -->
    <section class="border-b border-line">
      <div class="u-container py-12 md:py-16">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
          <p class="mono-meta flex items-center gap-2">
            <span class="dot" aria-hidden="true"></span>
            Writing
          </p>
          <p class="mono-meta">{posts.length} {posts.length === 1 ? "entry" : "entries"}</p>
        </div>

        <span class="sr-only" data-pagefind-meta="title">Writing — Afghan Eka Pangestu</span>
        <h1 class="display-lg text-[clamp(2.2rem,8vw,4.5rem)] animate-fade-up">
          Notes on<br />
          <span class="text-accent">building things.</span>
        </h1>

        <p class="lead mt-6 max-w-[54ch] animate-fade-up delay-1">
          Long-form thinking on software development, architecture, and building for the web —
          written for developers who have to maintain the thing afterward.
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section class="section !pt-10 md:!pt-12">
      <div class="u-container">
        <!-- Search -->
        <div class="mb-6">
          <button
            type="button"
            id="blog-search-trigger"
            class="group flex w-full items-center gap-3 border border-line bg-surface px-4 py-3 text-left transition-colors hover:border-line-strong hover:bg-surface-2"
            aria-label="Search articles"
          >
            <svg class="h-4 w-4 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-3.8-3.8" stroke-linecap="round" />
            </svg>
            <span class="flex-1 text-[13px] text-muted">Search articles…</span>
            <span class="hidden font-mono text-[10px] uppercase tracking-[0.08em] text-muted/70 sm:inline">⌘K</span>
          </button>
        </div>

        {allTags.length > 0 && (
          <div class="mb-8 flex flex-wrap items-center gap-1.5 border-b border-line pb-5">
            <span class="mono-label mr-1">Filter</span>
            <a
              href="/blog"
              data-tag=""
              class="tag-btn min-h-[30px] px-2.5 py-1 transition-colors"
            >
              All
            </a>
            {allTags.map((tag) => (
              <a
                href={`/blog?tag=${encodeURIComponent(tag)}`}
                data-tag={tag}
                class="tag-btn min-h-[30px] px-2.5 py-1 transition-colors"
              >
                {tag}
              </a>
            ))}
            <span id="post-count" class="mono-meta ml-auto hidden sm:block">
              {posts.length} shown
            </span>
          </div>
        )}

        <div id="posts-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 md:gap-5">
          {posts.map((post) => (
            <div class="post-card" data-tags={post.data.tags.join(",")}>
              <BlogCard post={post} />
            </div>
          ))}
        </div>

        <div id="empty-state" class="hidden border border-dashed border-line-strong px-6 py-16 text-center">
          <p class="heading mb-2 text-[16px] text-text">Nothing filed here yet</p>
          <p class="mb-5 text-[13px] text-muted">No articles under that topic.</p>
          <a href="/blog" class="btn btn-sm">View all articles</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section !py-12 md:!py-16">
      <div class="u-container">
        <div class="flex flex-wrap items-center justify-between gap-5 border border-line bg-surface p-5 md:p-8">
          <div>
            <p class="mono-label mb-2">Want to talk shop?</p>
            <p class="heading text-[17px] text-text md:text-[20px]">Have a project in mind?</p>
          </div>
          <a href="/#contact" class="btn btn-primary">
            Get in touch
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m0 0l-6-6m6 6l-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ScrollToTop />
</BaseLayout>

<script>
  // Open the search palette from the blog page search bar.
  document.getElementById("blog-search-trigger")?.addEventListener("click", () => {
    (window as any).__toggleSearch?.();
  });

  (function () {
    const tag = new URLSearchParams(window.location.search).get("tag") || "";
    const cards = document.querySelectorAll("#posts-grid .post-card");
    const empty = document.getElementById("empty-state");
    const btns = document.querySelectorAll(".tag-btn");
    const count = document.getElementById("post-count");

    function filterBy(selectedTag) {
      let visible = 0;
      cards.forEach((card) => {
        const tags = (card.getAttribute("data-tags") || "").split(",");
        const match = !selectedTag || tags.includes(selectedTag);
        card.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      empty?.classList.toggle("hidden", visible > 0);
      if (count) count.textContent = `${visible} shown`;
    }

    function updateActive(selectedTag) {
      btns.forEach((btn) => {
        const active = (btn.getAttribute("data-tag") || "") === selectedTag;
        btn.classList.toggle("border-accent", active);
        btn.classList.toggle("text-accent", active);
        btn.classList.toggle("border-line", !active);
        btn.classList.toggle("text-muted", !active);
      });
    }

    if (tag) {
      filterBy(tag);
      updateActive(tag);
    } else {
      updateActive("");
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const t = btn.getAttribute("data-tag") || "";
        history.replaceState(null, "", t ? `/blog?tag=${encodeURIComponent(t)}` : "/blog");
        filterBy(t);
        updateActive(t);
      });
    });
  })();
</script>
