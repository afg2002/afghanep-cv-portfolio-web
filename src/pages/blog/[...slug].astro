---
import BlogLayout from "../../layouts/BlogLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import Giscus from "../../components/Giscus.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, excerpt, tags, coverImage } = post.data;
const { Content, headings = [] } = await post.render();

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const body = post.body || "";
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const currentSlug = post.id.replace(/\.(md|mdx)$/, "");
const related = allPosts
  .filter((p) => {
    const pSlug = p.id.replace(/\.(md|mdx)$/, "");
    return pSlug !== currentSlug && p.data.tags.some((t: string) => tags.includes(t));
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const canonical = new URL(`/blog/${currentSlug}`, Astro.site).href;
const tocHeadings = headings.filter((h: any) => h.depth >= 2 && h.depth <= 3);
---

<BlogLayout title={title} description={excerpt} date={date} tags={tags}>
  <Header />

  <main id="main-content" class="flex-1" data-pagefind-body>
    <!-- Reading progress -->
    <div id="progress-bar" class="fixed left-0 top-16 z-40 h-1 bg-acid md:top-[72px]" style="width: 0%"></div>

    <!-- Article masthead -->
    <section class="border-b-2 border-ink bg-paper">
      <div class="u-container py-10 md:py-16">
        <!-- Breadcrumb -->
        <nav class="mb-6 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.1em] text-ink-3" aria-label="Breadcrumb">
          <a href="/" class="text-ink-3 no-underline hover:text-ink">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog" class="text-ink-3 no-underline hover:text-ink">Writing</a>
          <span aria-hidden="true">/</span>
          <span class="text-ink">Article</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[1fr_260px] lg:items-end">
          <div class="min-w-0">
            {tags.length > 0 && (
              <div class="mb-5 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a
                    href={`/blog?tag=${encodeURIComponent(tag)}`}
                    class="chip no-underline hover:bg-acid"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}

            <h1
              class="display text-[clamp(2rem,6vw,4rem)] leading-[0.94]"
              itemprop="headline"
              data-pagefind-meta="title"
            >
              {title}
            </h1>

            {excerpt && (
              <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-2 md:text-lg">{excerpt}</p>
            )}
          </div>

          <!-- Meta block -->
          <div class="border-2 border-ink bg-paper-2 p-4">
            <dl class="space-y-2.5 font-mono text-[10px] uppercase tracking-[0.08em]">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-ink-3">Published</dt>
                <dd class="text-ink">
                  <time datetime={new Date(date).toISOString()} itemprop="datePublished">{formattedDate}</time>
                </dd>
              </div>
              <div class="flex items-center justify-between gap-3 border-t border-dashed border-ink/30 pt-2.5">
                <dt class="text-ink-3">Reading</dt>
                <dd class="text-ink">{readingTime} min</dd>
              </div>
              <div class="flex items-center justify-between gap-3 border-t border-dashed border-ink/30 pt-2.5">
                <dt class="text-ink-3">Length</dt>
                <dd class="text-ink">{wordCount.toLocaleString()} words</dd>
              </div>
              <div class="flex items-center justify-between gap-3 border-t border-dashed border-ink/30 pt-2.5">
                <dt class="text-ink-3">Author</dt>
                <dd class="text-ink">Afghan Eka</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Cover -->
    {coverImage && (
      <div class="border-b-2 border-ink bg-paper">
        <div class="u-container py-6 md:py-8">
          <img
            src={coverImage}
            alt={title}
            class="max-h-[440px] w-full border-2 border-ink object-cover shadow-brut"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Content -->
    <section class="bg-paper py-10 md:py-14">
      <div class="u-container">
        <!-- Mobile TOC -->
        {tocHeadings.length > 0 && (
          <details class="mb-8 border-2 border-ink bg-paper-2 lg:hidden">
            <summary class="flex cursor-pointer select-none items-center justify-between px-4 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink">
              On this page
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <nav class="border-t-2 border-ink px-4 py-3">
              <ul class="space-y-2">
                {tocHeadings.map((h: any) => (
                  <li class={h.depth === 3 ? "pl-4" : ""}>
                    <a href={`#${h.slug}`} class="font-mono text-[11px] leading-snug text-ink-3 no-underline hover:text-ink">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}

        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-14">
          <!-- Article body -->
          <article class="min-w-0" itemscope itemtype="https://schema.org/Article">
            <div class="prose" itemprop="articleBody">
              <Content />
            </div>

            <!-- Tags footer -->
            {tags.length > 0 && (
              <div class="mt-12 flex flex-wrap items-center gap-2 border-t-2 border-ink pt-6">
                <span class="mono-label mr-1 text-ink-3">Filed under</span>
                {tags.map((tag) => (
                  <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="chip no-underline hover:bg-acid">
                    {tag}
                  </a>
                ))}
              </div>
            )}

            <!-- Author card -->
            <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-2 border-ink bg-paper-2 p-5">
              <div class="flex items-center gap-4">
                <span class="flex h-11 w-11 items-center justify-center border-2 border-ink bg-acid font-display text-[13px]">AEP</span>
                <div>
                  <p class="text-sm font-bold text-ink">Afghan Eka Pangestu</p>
                  <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-3">
                    Software developer — Bogor, Indonesia
                  </p>
                </div>
              </div>
              <a href="/#contact" class="btn btn-sm btn-ink">Get in touch</a>
            </div>

            <!-- Related -->
            {related.length > 0 && (
              <section class="mt-14 border-t-2 border-ink pt-8">
                <h2 class="mono-label mb-5 flex items-center gap-2 text-ink-3">
                  <span class="index-num">→</span> Keep reading
                </h2>
                <div class="grid gap-4 sm:grid-cols-3">
                  {related.map((r) => {
                    const rSlug = r.id.replace(/\.(md|mdx)$/, "");
                    return (
                      <a
                        href={`/blog/${rSlug}`}
                        class="group flex flex-col border-2 border-ink bg-paper p-4 no-underline transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-brut-sm"
                      >
                        <p class="display-tight mb-3 line-clamp-3 text-sm leading-[1.15] text-ink group-hover:text-electric">
                          {r.data.title}
                        </p>
                        <p class="mt-auto font-mono text-[10px] uppercase tracking-[0.08em] text-ink-3">
                          {new Date(r.data.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                        </p>
                      </a>
                    );
                  })}
                </div>
              </section>
            )}
          </article>

          <!-- Desktop TOC -->
          <aside class="hidden lg:block" aria-label="Table of contents">
            {tocHeadings.length > 0 && (
              <nav class="sticky top-28 border-t-2 border-ink pt-4">
                <h2 class="mono-label mb-3 text-ink-3">On this page</h2>
                <ul class="space-y-2">
                  {tocHeadings.map((h: any) => (
                    <li class={h.depth === 3 ? "pl-3" : ""}>
                      <a
                        href={`#${h.slug}`}
                        data-toc={h.slug}
                        class="toc-link block border-l-2 border-transparent pl-3 font-mono text-[11px] leading-snug text-ink-3 no-underline transition-colors hover:text-ink"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </aside>
        </div>
      </div>
    </section>

    <!-- Comments -->
    <section class="border-t-2 border-ink bg-paper-2 py-12 md:py-16">
      <div class="u-container">
        <Giscus />
      </div>
    </section>
  </main>

  <Footer />
  <ScrollToTop />
</BlogLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: excerpt,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "Afghan Eka Pangestu",
    url: Astro.site,
  },
  url: canonical,
})} />

<script>
  // ── Progress bar ──
  const bar = document.getElementById("progress-bar");
  if (bar) {
    window.addEventListener(
      "scroll",
      () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      },
      { passive: true }
    );
  }

  // ── TOC active state ──
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  if (tocLinks.length > 0) {
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]"));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const active = document.querySelector(`[data-toc="${entry.target.id}"]`);
          tocLinks.forEach((l) => {
            l.classList.remove("text-ink", "border-ink", "font-medium");
            l.classList.add("text-ink-3", "border-transparent");
          });
          if (active) {
            active.classList.add("text-ink", "border-ink", "font-medium");
            active.classList.remove("text-ink-3", "border-transparent");
          }
        });
      },
      { rootMargin: "-96px 0px -65% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  }

  // ── Copy buttons for code blocks ──
  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const container = document.createElement("div");
    container.className = "relative group/code";
    pre.parentNode?.insertBefore(container, pre);
    container.appendChild(pre);

    const btn = document.createElement("button");
    btn.className =
      "absolute top-2 right-2 border-2 border-paper/40 bg-ink px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-paper/70 transition-colors hover:border-acid hover:text-acid opacity-0 group-hover/code:opacity-100 focus-visible:opacity-100";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code to clipboard");
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent || "";
      await navigator.clipboard.writeText(code);
      btn.textContent = "Copied";
      btn.classList.add("text-acid", "border-acid");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("text-acid", "border-acid");
      }, 2000);
    });
    container.appendChild(btn);
  });
</script>
