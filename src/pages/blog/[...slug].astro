---
import BlogLayout from "../../layouts/BlogLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import Giscus from "../../components/Giscus.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, excerpt, tags, coverImage } = post.data;
const { Content, headings = [] } = await post.render();

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const body = post.body || "";
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const currentSlug = post.id.replace(/\.(md|mdx)$/, "");
const related = allPosts
  .filter((p) => {
    const pSlug = p.id.replace(/\.(md|mdx)$/, "");
    return pSlug !== currentSlug && p.data.tags.some((t: string) => tags.includes(t));
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const canonical = new URL(`/blog/${currentSlug}`, Astro.site).href;
const tocHeadings = headings.filter((h: any) => h.depth >= 2 && h.depth <= 3);
// Dynamic OG image generated at build time (src/pages/og/[...slug].png.ts)
const isLocalCover = Boolean(coverImage) && typeof coverImage === "object";
const coverSrc = typeof coverImage === "string" ? coverImage : (coverImage as any)?.src;
const ogImage = (typeof coverImage === "string" ? coverImage : undefined) || `/og/${currentSlug}.png`;
---

<BlogLayout title={title} description={excerpt} date={date} tags={tags} ogImage={ogImage} canonical={canonical}>
  <Header />

  <main id="main-content" class="flex-1" data-pagefind-body>
    <div id="progress-bar" class="fixed left-0 top-14 z-40 h-[2px] bg-accent md:top-16" style="width: 0%"></div>

    <!-- Masthead -->
    <section class="border-b border-line">
      <div class="u-container py-10 md:py-14">
        <nav class="mb-6 flex items-center gap-2 mono-meta" aria-label="Breadcrumb">
          <a href="/" class="text-muted no-underline hover:text-text">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog" class="text-muted no-underline hover:text-text">Writing</a>
          <span aria-hidden="true">/</span>
          <span class="text-text-2">Article</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[1fr_260px] lg:items-end lg:gap-12">
          <div class="min-w-0">
            {tags.length > 0 && (
              <div class="mb-5 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag no-underline transition-colors hover:border-accent hover:text-accent">
                    {tag}
                  </a>
                ))}
              </div>
            )}

            <h1 class="display text-[clamp(1.85rem,5vw,3.25rem)] text-text" itemprop="headline" data-pagefind-meta="title">
              {title}
            </h1>

            {excerpt && <p class="lead mt-5 max-w-[56ch]">{excerpt}</p>}
          </div>

          <div class="border border-line bg-surface">
            <div class="border-b border-line px-4 py-2.5">
              <p class="mono-label">Metadata</p>
            </div>
            <dl class="divide-y divide-line">
              <div class="flex items-center justify-between gap-3 px-4 py-2.5">
                <dt class="mono-meta uppercase tracking-[0.08em]">Published</dt>
                <dd class="mono-meta text-text-2">
                  <time datetime={new Date(date).toISOString()} itemprop="datePublished">{formattedDate}</time>
                </dd>
              </div>
              <div class="flex items-center justify-between gap-3 px-4 py-2.5">
                <dt class="mono-meta uppercase tracking-[0.08em]">Reading</dt>
                <dd class="mono-meta text-text-2">{readingTime} min</dd>
              </div>
              <div class="flex items-center justify-between gap-3 px-4 py-2.5">
                <dt class="mono-meta uppercase tracking-[0.08em]">Length</dt>
                <dd class="mono-meta text-text-2">{wordCount.toLocaleString()} words</dd>
              </div>
              <div class="flex items-center justify-between gap-3 px-4 py-2.5">
                <dt class="mono-meta uppercase tracking-[0.08em]">Author</dt>
                <dd class="mono-meta text-text-2">Afghan Eka</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    {coverImage && (
      <div class="border-b border-line">
        <div class="u-container py-6">
          {isLocalCover ? (
            <Image
              src={coverImage as any}
              alt={title}
              widths={[640, 960, 1200]}
              sizes="(min-width: 1200px) 1120px, 92vw"
              format="webp"
              quality={78}
              loading="eager"
              class="max-h-[420px] w-full border border-line object-cover"
            />
          ) : (
            <img src={coverSrc} alt={title} class="max-h-[420px] w-full border border-line object-cover" loading="eager" />
          )}
        </div>
      </div>
    )}

    <!-- Content -->
    <section class="py-10 md:py-14">
      <div class="u-container">
        {tocHeadings.length > 0 && (
          <details class="mb-8 border border-line bg-surface lg:hidden">
            <summary class="flex min-h-[44px] cursor-pointer select-none items-center justify-between px-4 py-3">
              <span class="mono-label !text-text-2">On this page</span>
              <svg class="h-3.5 w-3.5 text-muted" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <nav class="border-t border-line px-4 py-3">
              <ul class="space-y-2">
                {tocHeadings.map((h: any) => (
                  <li class={h.depth === 3 ? "pl-4" : ""}>
                    <a href={`#${h.slug}`} class="text-[12.5px] leading-snug text-muted no-underline hover:text-text">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )}

        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-14">
          <article class="min-w-0" itemscope itemtype="https://schema.org/Article">
            <div class="prose" itemprop="articleBody">
              <Content />
            </div>

            {tags.length > 0 && (
              <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-line pt-6">
                <span class="mono-label mr-1">Filed under</span>
                {tags.map((tag) => (
                  <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag no-underline transition-colors hover:border-accent hover:text-accent">
                    {tag}
                  </a>
                ))}
              </div>
            )}

            <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border border-line bg-surface p-4 md:p-5">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-[2px] bg-text font-mono text-[11px] text-bg">AE</span>
                <div>
                  <p class="text-[13px] font-medium text-text">Afghan Eka Pangestu</p>
                  <p class="mono-meta">Software developer — Bogor, Indonesia</p>
                </div>
              </div>
              <a href="/#contact" class="btn btn-sm">Get in touch</a>
            </div>

            {related.length > 0 && (
              <section class="mt-14 border-t border-line pt-8">
                <h2 class="mono-label mb-4">Keep reading</h2>
                <div class="grid gap-3 sm:grid-cols-3">
                  {related.map((r) => {
                    const rSlug = r.id.replace(/\.(md|mdx)$/, "");
                    return (
                      <a
                        href={`/blog/${rSlug}`}
                        class="group flex flex-col border border-line bg-surface p-4 no-underline transition-colors hover:border-line-strong hover:bg-surface-2"
                      >
                        <p class="heading mb-3 line-clamp-3 text-[13px] leading-snug text-text transition-colors group-hover:text-accent">
                          {r.data.title}
                        </p>
                        <p class="mono-meta mt-auto">
                          {new Date(r.data.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                        </p>
                      </a>
                    );
                  })}
                </div>
              </section>
            )}
          </article>

          <aside class="hidden lg:block" aria-label="Table of contents">
            {tocHeadings.length > 0 && (
              <nav class="sticky top-24">
                <h2 class="mono-label mb-3">On this page</h2>
                <ul class="space-y-2 border-l border-line">
                  {tocHeadings.map((h: any) => (
                    <li class={h.depth === 3 ? "pl-3" : ""}>
                      <a
                        href={`#${h.slug}`}
                        data-toc={h.slug}
                        class="toc-link block -ml-px border-l border-transparent pl-3 text-[12.5px] leading-snug text-muted no-underline transition-colors hover:text-text"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </aside>
        </div>
      </div>
    </section>

    <section class="section !py-10 md:!py-14">
      <div class="u-container">
        <Giscus />
      </div>
    </section>
  </main>

  <Footer />
  <ScrollToTop />
</BlogLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  headline: title,
  description: excerpt,
  image: [new URL(ogImage, Astro.site).href],
  datePublished: new Date(date).toISOString(),
  dateModified: new Date(date).toISOString(),
  wordCount,
  keywords: tags.join(", "),
  inLanguage: "en",
  author: {
    "@type": "Person",
    "@id": `${Astro.site}#person`,
    name: "Afghan Eka Pangestu",
    url: Astro.site,
  },
  publisher: {
    "@type": "Person",
    "@id": `${Astro.site}#person`,
    name: "Afghan Eka Pangestu",
  },
  url: canonical,
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Writing", item: new URL("/blog", Astro.site).href },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
})} />

<script>
  const bar = document.getElementById("progress-bar");
  if (bar) {
    window.addEventListener(
      "scroll",
      () => {
        const top = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = `${Math.min(100, Math.max(0, height > 0 ? (top / height) * 100 : 0))}%`;
      },
      { passive: true }
    );
  }

  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  if (tocLinks.length > 0) {
    const headings = Array.from(document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]"));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const active = document.querySelector(`[data-toc="${entry.target.id}"]`);
          tocLinks.forEach((l) => {
            l.classList.remove("text-text", "border-accent");
            l.classList.add("text-muted", "border-transparent");
          });
          if (active) {
            active.classList.add("text-text", "border-accent");
            active.classList.remove("text-muted", "border-transparent");
          }
        });
      },
      { rootMargin: "-88px 0px -65% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  }

  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const container = document.createElement("div");
    container.className = "relative group/code";
    pre.parentNode?.insertBefore(container, pre);
    container.appendChild(pre);

    const btn = document.createElement("button");
    btn.className =
      "absolute right-2 top-2 rounded-[2px] border border-line bg-surface px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted opacity-0 transition-all hover:border-accent hover:text-accent group-hover/code:opacity-100 focus-visible:opacity-100";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code to clipboard");
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.querySelector("code")?.textContent || "");
      btn.textContent = "Copied";
      btn.classList.add("text-accent", "border-accent");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("text-accent", "border-accent");
      }, 2000);
    });
    container.appendChild(btn);
  });
</script>
