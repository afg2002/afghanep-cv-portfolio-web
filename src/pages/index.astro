---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import Education from "../components/Education.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": `${Astro.site}#person`,
    name: "Afghan Eka Pangestu",
    jobTitle: "Software Developer",
    url: Astro.site,
  },
};
---

<BaseLayout
  title="Software Developer"
  description="Afghan Eka Pangestu — software developer in Bogor, Indonesia. 2+ years building backend systems, web applications, APIs, and enterprise solutions with Java, Spring Boot, Laravel, Vue.js, and Go."
  ogImage="/og/site.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
  <Header />
  <main id="main-content" data-pagefind-body>
    <Hero />
    <Projects />
    <Skills />
    <Experience />
    <About />
    <Education />
    <Certifications />
    <Contact />
  </main>
  <Footer />
  <ScrollToTop />
</BaseLayout>
