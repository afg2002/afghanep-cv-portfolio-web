---
import BaseLayout from "./BaseLayout.astro";
export interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  readingTime?: number;
  ogImage?: string;
  canonical?: string;
}
const { title, description, date, tags = [], readingTime, ogImage, canonical } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  type="article"
  ogImage={ogImage}
  canonical={canonical}
  publishedTime={date}
  modifiedTime={date}
  keywords={tags}
>
  <slot />
</BaseLayout>
