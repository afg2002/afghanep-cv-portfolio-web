---
const projects = [
  {
    index: "01",
    title: "SehatSegar.my.id",
    year: "Live",
    summary:
      "Laravel point-of-sale platform handling product management, inventory tracking, cashier transactions, and sales reporting — with a dashboard and multi-user access built for day-to-day shop operations.",
    tags: ["Laravel", "MySQL", "POS"],
    href: "https://sehatsegar.my.id",
  },
  {
    index: "02",
    title: "Movie Ticket Booking",
    year: "2024",
    summary:
      "End-to-end ticket booking flow with intuitive browsing, seat selection, and checkout — engineered for a frictionless path from discovery to payment confirmation.",
    tags: ["Vue.js 2", "Vuetify", "MongoDB"],
    href: "",
  },
  {
    index: "03",
    title: "Zero Waste API",
    year: "2024",
    summary:
      "REST API powering a cleaning-service booking application: scheduling, service catalog, and order lifecycle designed for a React client.",
    tags: ["React", "Express", "REST API"],
    href: "",
  },
  {
    index: "04",
    title: "Project Management System",
    year: "2023",
    summary:
      "Internal Laravel application for project calculation, budget planning (RAB), and vendor management — replacing spreadsheet workflows with a single source of truth.",
    tags: ["Laravel", "PHP", "MySQL"],
    href: "",
  },
  {
    index: "05",
    title: "Router Dashboard",
    year: "2024",
    summary:
      "Spring Boot + Vue.js 2 dashboard for router listing and real-time log monitoring at a national sharia bank.",
    tags: ["Spring Boot", "Vue.js 2", "Java"],
    href: "",
  },
  {
    index: "06",
    title: "Baca Komik",
    year: "2020",
    summary:
      "Python tool that scrapes comic chapters, converts them into searchable PDFs, and packages them for offline reading.",
    tags: ["Python", "Scraping", "PDF"],
    href: "",
  },
];

const moreProjects = [
  "Digital Library Web",
  "GYM Information System",
  "Boarding House Selection DSS (AHP)",
  "Inventory Management System",
  "Major Selection Expert System",
  "Best Employee DSS (SAW)",
  "Dengue & Typhoid Diagnosis ES",
  "Java Swing Academic System",
];
---

<section id="work" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="01">Selected work</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">Things I've built</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        {projects.length} featured builds, {moreProjects.length} more in the list below. Production systems, internal tooling, and side projects.
      </p>
    </div>

    <!-- Project list: rule-separated rows, not boxed cards -->
    <ul class="border-t border-line">
      {projects.map((p) => (
        <li class="group border-b border-line">
          <div class="grid gap-x-8 gap-y-3 py-6 md:grid-cols-[64px_1fr_200px] md:py-7">
            <div class="flex items-center gap-3 md:block">
              <span class="tnum text-[13px] text-muted transition-colors group-hover:text-accent">{p.index}</span>
            </div>

            <div class="min-w-0">
              <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="heading text-[17px] text-text md:text-[19px]">{p.title}</h3>
                <span class="mono-meta">{p.year}</span>
              </div>
              <p class="mb-3 max-w-[62ch] text-[13.5px] leading-relaxed text-text-2">{p.summary}</p>
              <div class="flex flex-wrap items-center gap-1.5">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>

            <div class="flex items-start justify-start md:justify-end">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener" class="link-arrow">
                  Visit
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ) : (
                <span class="mono-meta">Case study on request</span>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- More projects -->
    <details class="group mt-8 border border-line bg-surface">
      <summary class="flex min-h-[44px] cursor-pointer select-none items-center justify-between gap-4 px-4 py-3">
        <span class="mono-label !text-text-2">+ Eight more builds</span>
        <svg class="h-3.5 w-3.5 text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <ul class="grid grid-cols-1 border-t border-line sm:grid-cols-2">
        {moreProjects.map((mp, i) => (
          <li
            class:list={[
              "flex items-center gap-3 px-4 py-3",
              i % 2 === 1 && "sm:border-l sm:border-line",
              i >= 2 && "border-t border-line",
            ]}
          >
            <span class="tnum text-[10px] text-muted">{String(i + 7).padStart(2, "0")}</span>
            <span class="text-[13px] text-text-2">{mp}</span>
          </li>
        ))}
      </ul>
    </details>
  </div>
</section>
