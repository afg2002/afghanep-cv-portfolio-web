---
const projects = [
  {
    index: "01",
    title: "SehatSegar.my.id",
    year: "Live",
    summary:
      "Laravel point-of-sale platform handling product management, inventory tracking, cashier transactions, and sales reporting — with a dashboard and multi-user access built for day-to-day shop operations.",
    tags: ["Laravel", "MySQL", "POS"],
    accent: "acid",
    href: "https://sehatsegar.my.id",
  },
  {
    index: "02",
    title: "Movie Ticket Booking",
    year: "2024",
    summary:
      "End-to-end ticket booking flow with intuitive browsing, seat selection, and checkout — engineered for a frictionless path from discovery to payment confirmation.",
    tags: ["Vue.js 2", "Vuetify", "MongoDB"],
    accent: "lilac",
    href: "",
  },
  {
    index: "03",
    title: "Zero Waste API",
    year: "2024",
    summary:
      "REST API powering a cleaning-service booking application: scheduling, service catalog, and order lifecycle designed for a React client.",
    tags: ["React", "Express", "REST API"],
    accent: "coral",
    href: "",
  },
  {
    index: "04",
    title: "Project Management System",
    year: "2023",
    summary:
      "Internal Laravel application for project calculation, budget planning (RAB), and vendor management — replacing spreadsheet workflows with a single source of truth.",
    tags: ["Laravel", "PHP", "MySQL"],
    accent: "paper",
    href: "",
  },
  {
    index: "05",
    title: "Router Dashboard",
    year: "2024",
    summary:
      "Spring Boot + Vue.js 2 dashboard for router listing and real-time log monitoring at a national sharia bank.",
    tags: ["Spring Boot", "Vue.js 2", "Java"],
    accent: "paper",
    href: "",
  },
  {
    index: "06",
    title: "Baca Komik",
    year: "2020",
    summary:
      "Python tool that scrapes comic chapters, converts them into searchable PDFs, and packages them for offline reading.",
    tags: ["Python", "Scraping", "PDF"],
    accent: "paper",
    href: "",
  },
];

const moreProjects = [
  "Digital Library Web",
  "GYM Information System",
  "Boarding House Selection DSS (AHP)",
  "Inventory Management System",
  "Major Selection Expert System",
  "Best Employee DSS (SAW)",
  "Dengue & Typhoid Diagnosis ES",
  "Java Swing Academic System",
];

const accentClass: Record<string, string> = {
  acid: "bg-acid",
  lilac: "bg-lilac",
  coral: "bg-coral",
  paper: "bg-paper-2",
};
---

<section id="work" class="scroll-mt-24 border-b-2 border-ink bg-paper py-16 md:py-24">
  <div class="u-container">
    <!-- Section head -->
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-6 md:mb-14">
      <div>
        <p class="mono-label mb-3 flex items-center gap-2 text-ink-3">
          <span class="index-num">01</span> Selected work
        </p>
        <h2 class="display text-[clamp(2.25rem,6.5vw,4.5rem)]">
          Things I've<br class="sm:hidden" /> built
        </h2>
      </div>
      <p class="max-w-xs font-mono text-[11px] uppercase leading-relaxed tracking-[0.06em] text-ink-3">
        06 featured builds out of 14+ shipped.<br />
        Production systems, internal tools,<br />
        and the occasional side quest.
      </p>
    </div>

    <!-- Featured grid -->
    <div class="grid gap-5 md:grid-cols-2 md:gap-6">
      {projects.map((p, i) => (
        <article
          class:list={[
            "brut group relative flex flex-col p-6 transition-all duration-150 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[8px_8px_0_var(--color-ink)] md:p-8",
            i === 0 && "md:col-span-2",
          ]}
        >
          <div class="mb-5 flex items-start justify-between gap-4">
            <span
              class:list={[
                "inline-flex h-11 w-11 shrink-0 items-center justify-center border-2 border-ink font-display text-sm",
                accentClass[p.accent] ?? "bg-paper-2",
              ]}
            >
              {p.index}
            </span>
            <span class="chip">{p.year}</span>
          </div>

          <h3 class:list={["display-tight mb-3", i === 0 ? "text-[clamp(1.6rem,4vw,2.75rem)]" : "text-2xl md:text-[28px]"]}>
            {p.title}
          </h3>

          <p class:list={["mb-6 text-sm leading-relaxed text-ink-2", i === 0 ? "max-w-2xl md:text-base" : ""]}>
            {p.summary}
          </p>

          <div class="mt-auto flex flex-wrap items-center justify-between gap-4 border-t-2 border-dashed border-ink/25 pt-4">
            <div class="flex flex-wrap gap-1.5">
              {p.tags.map((t) => <span class="chip">{t}</span>)}
            </div>
            {p.href ? (
              <a
                href={p.href}
                target="_blank"
                rel="noopener"
                class="group/link inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-ink no-underline"
              >
                <span class="border-b-2 border-ink pb-0.5 group-hover/link:bg-acid">Visit</span>
                <svg class="h-3 w-3 transition-transform group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="square" d="M7 17L17 7M9 7h8v8" />
                </svg>
              </a>
            ) : (
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-3/70">Case study on request</span>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- More projects -->
    <details class="group mt-10 border-2 border-ink bg-paper-2/60">
      <summary
        class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-mono text-[11px] uppercase tracking-[0.12em] text-ink transition-colors hover:bg-acid md:px-6"
      >
        <span class="flex items-center gap-3">
          <span class="text-ink-3">+08</span>
          Eight more builds
        </span>
        <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <ul class="grid grid-cols-1 border-t-2 border-ink sm:grid-cols-2">
        {moreProjects.map((mp, i) => (
          <li class:list={[
            "flex items-center gap-3 px-5 py-4 md:px-6",
            i === 1 && "border-t-2 border-ink sm:border-t-0",
            i >= 2 && "border-t-2 border-ink",
            i % 2 === 1 && "sm:border-l-2 sm:border-ink",
          ]}>
            <span class="font-mono text-[10px] text-ink-3">{String(i + 7).padStart(2, "0")}</span>
            <span class="text-sm font-medium text-ink-2">{mp}</span>
          </li>
        ))}
      </ul>
    </details>
  </div>
</section>
