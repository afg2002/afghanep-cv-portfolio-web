---
const experiences = [
  {
    company: "Generali Indonesia",
    role: "Java Developer",
    type: "Full Time",
    period: "Present",
    current: true,
    highlights: [
      "Developing and maintaining Java-based applications for core insurance business needs",
      "Building reliable backend services with a focus on maintainability and system integration",
    ],
  },
  {
    company: "PT Inmotion Inovasi Teknologi",
    role: "Web Developer",
    type: "Former",
    period: "Previous",
    current: false,
    highlights: [
      "Built chatbot, omni-channel, Generative AI, and SRM solutions using Java and MVEL",
      "Integrated Salesforce with chat platforms for a major national bank",
      "Designed WhatsApp Flows connected to hospital scheduling and digital services",
      "Delivered chatbot automation for financial institutions",
      "Consulted directly with clients on technical solution design",
    ],
  },
  {
    company: "PT BTPN Syariah Tbk",
    role: "Web Developer",
    type: "Internship",
    period: "Feb — Jun 2024",
    current: false,
    highlights: [
      "Built a router application with Spring Boot and Vue.js 2 for dashboard listing and log monitoring",
      "Supported the Product Owner in documenting user feedback surveys",
      "Completed the MSIB Batch 6 program",
    ],
  },
  {
    company: "PT Ciptanusa Nuansa Mulia",
    role: "Web Developer",
    type: "Freelance",
    period: "Sep — Dec 2023",
    current: false,
    highlights: [
      "Developed a project management application with Laravel",
      "Implemented project calculation, budgeting (RAB), and vendor management",
      "Cut workflow friction across the whole project management process",
    ],
  },
  {
    company: "Royal Star — PT Bintang Bahagia Selalu",
    role: "Web Developer",
    type: "Freelance",
    period: "Sep — Oct 2022",
    current: false,
    highlights: [
      "Reworked the front-end experience: slider, video display, navigation menu, and WhatsApp CTA",
      "Improved overall usability and visual consistency of the storefront",
    ],
  },
  {
    company: "CV Mitrasoft Global",
    role: "Web Developer",
    type: "Internship",
    period: "Jan — Mar 2019",
    current: false,
    highlights: [
      "Migrated a desktop customer back-office application to the web using Java Spring",
      "Added new features and a more responsive UI, improving operational efficiency",
    ],
  },
];

const typeChip: Record<string, string> = {
  "Full Time": "chip-coral",
  Internship: "chip-lilac",
  Former: "chip",
  Freelance: "chip-acid",
};
---

<section id="experience" class="scroll-mt-24 border-b-2 border-ink bg-paper py-16 md:py-24">
  <div class="u-container">
    <!-- Section head -->
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-6 md:mb-14">
      <div>
        <p class="mono-label mb-3 flex items-center gap-2 text-ink-3">
          <span class="index-num">03</span> Track record
        </p>
        <h2 class="display text-[clamp(2.25rem,6.5vw,4.5rem)]">
          Where I've<br class="sm:hidden" /> worked
        </h2>
      </div>
      <p class="max-w-xs font-mono text-[11px] uppercase leading-relaxed tracking-[0.06em] text-ink-3">
        Six roles across insurance, banking,<br />
        agency work, and freelance builds.<br />
        Newest first.
      </p>
    </div>

    <!-- Ledger -->
    <ol class="border-t-2 border-ink">
      {experiences.map((exp, i) => (
        <li class="group border-b-2 border-ink">
          <div class="grid gap-4 py-6 md:grid-cols-[56px_1fr_220px] md:gap-8 md:py-8">
            <!-- Index -->
            <div class="flex items-start gap-3 md:block">
              <span class="font-display text-lg leading-none text-ink-3/50 transition-colors group-hover:text-ink">
                {String(i + 1).padStart(2, "0")}
              </span>
              {exp.current && (
                <span class="md:mt-2 md:block">
                  <span class="mono-label inline-flex items-center gap-1.5 text-ink">
                    <span class="h-1.5 w-1.5 bg-coral" aria-hidden="true"></span>Now
                  </span>
                </span>
              )}
            </div>

            <!-- Main -->
            <div>
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <h3 class="display-tight text-xl transition-colors group-hover:text-electric md:text-[26px]">
                  {exp.company}
                </h3>
                <span class:list={["chip", typeChip[exp.type] ?? "chip"]}>{exp.type}</span>
              </div>
              <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">{exp.role}</p>
              <ul class="space-y-1.5">
                {exp.highlights.map((h) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-ink-2">
                    <span class="mt-[7px] h-1.5 w-1.5 shrink-0 bg-ink" aria-hidden="true"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Period -->
            <div class="md:text-right">
              <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3">{exp.period}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink-3">
        Full history available in the CV.
      </p>
      <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" rel="noopener" class="btn btn-acid btn-sm">
        Download CV
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" />
        </svg>
      </a>
    </div>
  </div>
</section>
