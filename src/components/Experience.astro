---
const experiences = [
  {
    company: "Generali Indonesia",
    role: "Java Developer",
    type: "Full time",
    period: "2024 — Present",
    current: true,
    highlights: [
      "Developing and maintaining Java-based applications for core insurance business needs",
      "Building reliable backend services with a focus on maintainability and system integration",
    ],
  },
  {
    company: "PT Inmotion Inovasi Teknologi",
    role: "Web Developer",
    type: "Full time",
    period: "2024",
    current: false,
    highlights: [
      "Built chatbot, omni-channel, Generative AI, and SRM solutions using Java and MVEL",
      "Integrated Salesforce with chat platforms for a major national bank",
      "Designed WhatsApp Flows connected to hospital scheduling and digital services",
      "Consulted directly with clients on technical solution design",
    ],
  },
  {
    company: "PT BTPN Syariah Tbk",
    role: "Web Developer",
    type: "Internship",
    period: "Feb — Jun 2024",
    current: false,
    highlights: [
      "Built a router application with Spring Boot and Vue.js 2 for dashboard listing and log monitoring",
      "Supported the Product Owner in documenting user feedback surveys",
      "Completed the MSIB Batch 6 program",
    ],
  },
  {
    company: "PT Ciptanusa Nuansa Mulia",
    role: "Web Developer",
    type: "Freelance",
    period: "Sep — Dec 2023",
    current: false,
    highlights: [
      "Developed a project management application with Laravel",
      "Implemented project calculation, budgeting (RAB), and vendor management",
      "Cut workflow friction across the whole project management process",
    ],
  },
  {
    company: "Royal Star — PT Bintang Bahagia Selalu",
    role: "Web Developer",
    type: "Freelance",
    period: "Sep — Oct 2022",
    current: false,
    highlights: [
      "Reworked the front-end experience: slider, video display, navigation menu, and WhatsApp CTA",
      "Improved overall usability and visual consistency of the storefront",
    ],
  },
  {
    company: "CV Mitrasoft Global",
    role: "Web Developer",
    type: "Internship",
    period: "Jan — Mar 2019",
    current: false,
    highlights: [
      "Migrated a desktop customer back-office application to the web using Java Spring",
      "Added new features and a more responsive UI, improving operational efficiency",
    ],
  },
];
---

<section id="experience" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="03">Track record</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">Where I've worked</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        Professional roles from 2024, plus freelance and internship work before that. Newest first.
      </p>
    </div>

    <ol class="border-t border-line">
      {experiences.map((exp) => (
        <li class="group border-b border-line">
          <div class="grid gap-x-8 gap-y-3 py-6 md:grid-cols-[1fr_168px] md:py-7">
            <div class="min-w-0">
              <!-- Company + dotted leader + period (spec-sheet row) -->
              <div class="mb-2 flex flex-wrap items-baseline gap-x-2">
                <h3 class="heading text-[17px] text-text md:text-[19px]">{exp.company}</h3>
                <span class="leader hidden md:block" aria-hidden="true"></span>
                <span class="mono-meta whitespace-nowrap">{exp.period}</span>
              </div>

              <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <p class="text-[13px] font-medium text-text-2">{exp.role}</p>
                <span class="text-muted" aria-hidden="true">·</span>
                <span class="mono-meta">{exp.type}</span>
                {exp.current && (
                  <span class="tag tag-accent">
                    <span class="dot pulse-dot" aria-hidden="true"></span>
                    Current
                  </span>
                )}
              </div>

              <ul class="space-y-1.5">
                {exp.highlights.map((h) => (
                  <li class="relative pl-4 text-[13.5px] leading-relaxed text-text-2">
                    <span class="absolute left-0 top-[0.6em] h-[3px] w-[3px] rounded-full bg-accent" aria-hidden="true"></span>
                    {h}
                  </li>
                ))}
              </ul>
            </div>

            <div class="hidden md:block" aria-hidden="true"></div>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="mono-meta">Professional experience: 2+ years (since 2024)</p>
      <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" rel="noopener" class="link-arrow">
        Full history in the CV
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
