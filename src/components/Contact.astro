---
const channels = [
  { label: "Email", value: "afghanekapangestu@gmail.com", href: "mailto:afghanekapangestu@gmail.com", note: "Best for project briefs" },
  { label: "Phone", value: "+62 851 5628 3645", href: "tel:+6285156283645", note: "Mon–Fri, 09:00–18:00 WIB" },
  { label: "LinkedIn", value: "in/afghan-eka-pangestu", href: "https://www.linkedin.com/in/afghan-eka-pangestu/", note: "Professional enquiries" },
  { label: "GitHub", value: "github.com/afg2002", href: "https://github.com/afg2002", note: "Code & experiments" },
];
---

<section id="contact" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="07">Contact</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">Let's build something</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        Open to freelance projects, contract work, and full-time roles — remote friendly.
      </p>
    </div>

    <div class="grid gap-10 lg:grid-cols-[1fr_300px] lg:gap-16">
      <!-- Channels -->
      <ul class="border-t border-line">
        {channels.map((c) => (
          <li class="border-b border-line">
            <a
              href={c.href}
              target={c.href.startsWith("http") ? "_blank" : undefined}
              rel={c.href.startsWith("http") ? "noopener" : undefined}
              class="group grid grid-cols-[68px_1fr_auto] items-center gap-x-4 gap-y-1 py-4 no-underline"
            >
              <span class="mono-meta uppercase tracking-[0.1em]">{c.label}</span>
              <div class="min-w-0">
                <p class="truncate text-[14px] font-medium text-text transition-colors group-hover:text-accent">{c.value}</p>
                <p class="mono-meta mt-0.5">{c.note}</p>
              </div>
              <svg class="h-3.5 w-3.5 text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA panel -->
      <div class="border border-line bg-surface p-5 md:p-6">
        <p class="mono-label mb-3 flex items-center gap-2">
          <span class="dot pulse-dot" aria-hidden="true"></span>
          Available
        </p>
        <p class="heading mb-3 text-[17px] text-text">Have a backlog of half-finished specs?</p>
        <p class="mb-5 text-[13px] leading-relaxed text-text-2">
          Send the short version of your project — I'll reply with how I'd approach the architecture
          and roughly what it takes.
        </p>
        <div class="space-y-2">
          <a
            href="mailto:afghanekapangestu@gmail.com?subject=Project%20enquiry"
            class="btn btn-accent w-full"
          >
            Send an email
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m0 0l-6-6m6 6l-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" rel="noopener" class="btn w-full">
            Download CV (PDF)
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
