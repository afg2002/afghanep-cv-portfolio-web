---
const navLinks = [
  { href: "/#work", label: "Work" },
  { href: "/#stack", label: "Stack" },
  { href: "/#experience", label: "Experience" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
  { href: "/blog", label: "Writing" },
];

const socials = [
  { href: "https://github.com/afg2002", label: "GitHub" },
  { href: "https://www.linkedin.com/in/afghan-eka-pangestu/", label: "LinkedIn" },
  { href: "mailto:afghanekapangestu@gmail.com", label: "Email" },
  { href: "/cv-afghan-eka-pangestu.pdf", label: "CV" },
  { href: "/rss.xml", label: "RSS" },
  { href: "/status", label: "Status" },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-line" data-pagefind-ignore>
  <div class="u-container py-12 md:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <p class="heading mb-3 text-[15px] text-text">Afghan Eka Pangestu</p>
        <p class="max-w-[38ch] text-[13px] leading-relaxed text-muted">
          Software developer in Bogor, Indonesia. Backend systems, APIs, and enterprise
          applications that hold up in production.
        </p>
        <a
          href="mailto:afghanekapangestu@gmail.com"
          class="mono-meta mt-4 inline-block text-text-2 no-underline transition-colors hover:text-accent"
        >
          afghanekapangestu@gmail.com
        </a>
      </div>

      <div>
        <p class="mono-label mb-3">Navigate</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-1">
          {navLinks.map((l) => (
            <li>
              <a href={l.href} class="text-[13px] text-muted no-underline transition-colors hover:text-text">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mono-label mb-3">Elsewhere</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-1">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith("http") ? "_blank" : undefined}
                rel={s.href.startsWith("http") ? "noopener" : undefined}
                class="text-[13px] text-muted no-underline transition-colors hover:text-text"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5">
      <p class="mono-meta">© {year} Afghan Eka Pangestu</p>
      <p class="mono-meta flex items-center gap-2">
        <span class="dot pulse-dot" aria-hidden="true"></span>
        Available for freelance
      </p>
      <p class="mono-meta">Astro · Tailwind · Pagefind</p>
    </div>
  </div>
</footer>
