---
const groups = [
  {
    num: "01",
    label: "Backend",
    blurb: "Services, integrations, and business logic.",
    skills: ["PHP", "Laravel", "Java", "Spring Boot", "Golang", "Express"],
  },
  {
    num: "02",
    label: "Frontend",
    blurb: "Interfaces that stay fast under real data.",
    skills: ["HTML", "CSS", "JavaScript", "Vue.js 2", "Vuetify", "React"],
  },
  {
    num: "03",
    label: "Data & tooling",
    blurb: "Storage, versioning, and the daily workflow.",
    skills: ["MySQL", "MongoDB", "Git", "Terminal", "VS Code"],
  },
  {
    num: "04",
    label: "Engineering craft",
    blurb: "How the work actually gets done.",
    skills: ["Clean Architecture", "Scalability", "Maintainability", "Problem Solving", "Teamwork"],
  },
];

const languages = [
  { name: "Indonesian", level: "Native", pct: 100 },
  { name: "English", level: "Professional reading", pct: 65 },
];
---

<section id="stack" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="02">Capabilities</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">The stack I work in</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        Pragmatic choices over hype — boring, proven tools that hold up in production.
      </p>
    </div>

    <div class="grid gap-x-12 gap-y-8 sm:grid-cols-2">
      {groups.map((g) => (
        <div class="border-t border-line pt-4">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="tnum text-[11px] text-muted">{g.num}</span>
            <h3 class="heading text-[15px] text-text">{g.label}</h3>
          </div>
          <p class="mb-4 text-[13px] leading-relaxed text-muted">{g.blurb}</p>
          <ul class="flex flex-wrap gap-1.5">
            {g.skills.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- Languages -->
    <div class="mt-12 grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
      {languages.map((l) => (
        <div>
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <p class="text-[13px] font-medium text-text">{l.name}</p>
            <p class="mono-meta">{l.level}</p>
          </div>
          <div class="h-1 w-full bg-line" role="presentation">
            <div class="h-full bg-accent" style={`width: ${l.pct}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
