---
const stack = ["Laravel", "Vue.js", "Java", "Spring Boot", "Golang", "React", "Express", "MySQL", "MongoDB"];
const marqueeItems = [
  "Backend Engineering",
  "Enterprise Systems",
  "API Design",
  "Chatbot & Omni-channel",
  "Clean Architecture",
  "Generative AI Integrations",
];
---

<section id="home" class="relative overflow-hidden border-b-2 border-ink bg-paper">
  <!-- Editorial grid wash -->
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="relative">
    <div class="u-container pt-14 pb-16 md:pt-20 md:pb-24">
      <!-- Top meta row -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b-2 border-ink pb-4 md:mb-12">
        <p class="mono-label flex items-center gap-2 text-ink-3 animate-fade-up">
          <span class="inline-block h-2 w-2 bg-coral blink" aria-hidden="true"></span>
          Portfolio / 2026
          <span class="hidden text-ink-3/40 sm:inline">—</span>
          <span class="hidden sm:inline">Bogor, ID</span>
        </p>
        <p class="mono-label hidden items-center gap-2 text-ink-3 md:flex animate-fade-up delay-1">
          <span class="chip chip-acid">Open to work</span>
          <span>Software Developer</span>
        </p>
      </div>

      <div class="grid gap-10 lg:grid-cols-[1.55fr_1fr] lg:gap-16">
        <!-- Left: headline block -->
        <div>
          <p class="mono-label mb-5 text-ink-3 animate-fade-up">Afghan Eka Pangestu — Software Developer</p>

          <h1
            class="display text-[clamp(3rem,10.5vw,7.6rem)] animate-fade-up delay-1"
            data-pagefind-meta="title"
          >
            I build<br />
            <span class="text-outline">systems</span><br />
            that <span class="relative inline-block">
              <span class="hl">ship.</span>
            </span>
          </h1>

          <p class="mt-8 max-w-xl text-base leading-relaxed text-ink-2 sm:text-lg animate-fade-up delay-2">
            Backend-focused developer with 6+ years of shipping web applications, internal
            enterprise tools, and chatbot platforms. I turn messy business requirements into
            <strong class="font-bold text-ink">maintainable architecture</strong> that real people
            actually use.
          </p>

          <!-- Actions -->
          <div class="mt-9 flex flex-wrap items-center gap-3 animate-fade-up delay-3">
            <a href="#work" class="btn btn-acid">
              See the work
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" d="M12 4v16m0 0l-6-6m6 6l6-6" />
              </svg>
            </a>
            <a href="#contact" class="btn btn-ink">
              Hire me
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
              </svg>
            </a>
            <a
              href="/cv-afghan-eka-pangestu.pdf"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 px-2 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink no-underline"
            >
              <span class="border-b-2 border-ink pb-0.5 transition-colors group-hover:bg-acid">Download CV</span>
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" />
              </svg>
            </a>
          </div>

          <!-- Contact rails -->
          <div class="mt-10 flex flex-wrap gap-x-5 gap-y-3 border-t-2 border-dashed border-ink/30 pt-5 animate-fade-up delay-4">
            <a href="mailto:afghanekapangestu@gmail.com" class="hero-contact">afghanekapangestu@gmail.com</a>
            <a href="https://github.com/afg2002" target="_blank" rel="noopener" class="hero-contact">GitHub</a>
            <a href="https://www.linkedin.com/in/afghan-eka-pangestu/" target="_blank" rel="noopener" class="hero-contact">LinkedIn</a>
            <a href="tel:085156283645" class="hero-contact">0851&nbsp;5628&nbsp;3645</a>
          </div>
        </div>

        <!-- Right: terminal card -->
        <div class="relative animate-fade-up delay-2">
          <div class="relative border-2 border-ink bg-ink shadow-brut-lg">
            <!-- Window bar -->
            <div class="flex items-center justify-between border-b-2 border-paper/20 px-4 py-2.5">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 border border-paper/40 bg-coral"></span>
                <span class="h-2.5 w-2.5 border border-paper/40 bg-acid"></span>
                <span class="h-2.5 w-2.5 border border-paper/40 bg-lilac"></span>
              </div>
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-paper/50">aep — profile.json</p>
              <span class="font-mono text-[10px] text-paper/30" aria-hidden="true">01</span>
            </div>

            <!-- Body -->
            <div class="space-y-2.5 p-5 font-mono text-[12.5px] leading-relaxed text-paper/85 sm:text-[13px]">
              <p><span class="text-paper/35">$</span> <span class="text-acid">whoami</span></p>
              <p class="text-paper/60">→ afghan_eka_pangestu</p>
              <p><span class="text-paper/35">$</span> <span class="text-acid">cat role.txt</span></p>
              <p class="text-paper/60">→ "Java Developer @ Generali Indonesia"</p>
              <p><span class="text-paper/35">$</span> <span class="text-acid">cat focus.txt</span></p>
              <p class="text-paper/60">
                → enterprise backend,<br />
                &nbsp;&nbsp;API design, integration
              </p>
              <p><span class="text-paper/35">$</span> <span class="text-acid">status --remote</span></p>
              <p class="flex items-center gap-2 text-acid">
                <span class="inline-block h-2 w-2 bg-acid blink" aria-hidden="true"></span>
                available for freelance
              </p>
              <p class="pt-1"><span class="text-paper/35">$</span> <span class="inline-block h-4 w-2 translate-y-0.5 bg-acid blink" aria-hidden="true"></span></p>
            </div>

            <!-- Stats strip -->
            <div class="grid grid-cols-3 border-t-2 border-paper/20">
              <div class="border-r-2 border-paper/20 px-3 py-3 text-center">
                <p class="font-display text-lg leading-none text-acid">6+</p>
                <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.12em] text-paper/45">Years</p>
              </div>
              <div class="border-r-2 border-paper/20 px-3 py-3 text-center">
                <p class="font-display text-lg leading-none text-acid">14+</p>
                <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.12em] text-paper/45">Projects</p>
              </div>
              <div class="px-3 py-3 text-center">
                <p class="font-display text-lg leading-none text-acid">3.62</p>
                <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.12em] text-paper/45">GPA</p>
              </div>
            </div>
          </div>

          <!-- Badge, offset outside the card for that sticker feel -->
          <span
            class="absolute -top-4 -right-3 z-10 rotate-[8deg] border-2 border-ink bg-lilac px-3 py-1.5 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-ink shadow-brut-xs sm:-right-4"
          >
            Java · PHP · Go
          </span>

          <!-- Stack tags -->
          <div class="mt-5 flex flex-wrap gap-1.5">
            {stack.map((s) => <span class="chip bg-paper">{s}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="marquee border-t-2 border-ink bg-acid" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {marqueeItems.map((item) => (
            <span class="flex items-center gap-6 whitespace-nowrap px-6 py-3 font-display text-sm uppercase tracking-tight text-ink md:text-base">
              {item}
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0l3.1 8.9L24 12l-8.9 3.1L12 24l-3.1-8.9L0 12l8.9-3.1z" />
              </svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-contact {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .hero-contact:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
</style>
