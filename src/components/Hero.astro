---
const stack = ["Java", "Spring Boot", "Laravel", "Vue.js", "Go", "React", "MySQL", "MongoDB"];

const facts = [
  { label: "Now", value: "Java Developer" },
  { label: "At", value: "Generali Indonesia" },
  { label: "Based", value: "Bogor, Indonesia" },
  { label: "Since", value: "2024" },
];
---

<section id="home" class="relative overflow-hidden border-b border-line">
  <div class="u-container pb-14 pt-12 md:pb-20 md:pt-20">
    <!-- Meta rail -->
    <div class="mb-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-3 md:mb-16">
      <p class="mono-meta flex items-center gap-2">
        <span class="dot pulse-dot" aria-hidden="true"></span>
        Available for freelance
      </p>
      <p class="mono-meta hidden sm:block">Portfolio — v3</p>
      <p class="mono-meta">Bogor, ID · GMT+7</p>
    </div>

    <div class="grid gap-12 lg:grid-cols-[1fr_268px] lg:gap-16">
      <!-- Headline -->
      <div>
        <h1 class="display-lg text-[clamp(2.35rem,9.5vw,5.75rem)] animate-fade-up" data-pagefind-meta="title">
          I build backend<br />
          systems that<br />
          <span class="text-accent">hold up.</span>
        </h1>

        <p class="lead mt-7 max-w-[52ch] animate-fade-up delay-1">
          Software developer with <span class="font-medium text-text">2+ years</span> of professional
          experience building web applications, internal enterprise tools, and chatbot platforms.
          I turn business requirements into maintainable Java, Laravel, and Spring Boot services.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-2.5 animate-fade-up delay-2">
          <a href="#work" class="btn btn-primary">
            See selected work
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v15m0 0l-6-6m6 6l6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#contact" class="btn">Get in touch</a>
          <a
            href="/cv-afghan-eka-pangestu.pdf"
            target="_blank"
            rel="noopener"
            class="link-arrow ml-1 mt-1"
          >
            Download CV
            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Spec panel -->
      <aside class="animate-fade-up delay-2">
        <div class="border border-line bg-surface">
          <div class="border-b border-line px-4 py-2.5">
            <p class="mono-label">Profile</p>
          </div>
          <dl class="divide-y divide-line">
            {facts.map((f) => (
              <div class="flex items-baseline justify-between gap-3 px-4 py-3">
                <dt class="mono-meta uppercase tracking-[0.1em]">{f.label}</dt>
                <dd class="text-right text-[13px] font-medium leading-snug text-text">{f.value}</dd>
              </div>
            ))}
          </dl>
          <div class="flex items-center justify-between gap-3 border-t border-line px-4 py-3">
            <span class="mono-meta uppercase tracking-[0.1em]">Experience</span>
            <span class="tnum text-[13px] font-medium text-accent">2+ years</span>
          </div>
        </div>

        <div class="mt-3 flex flex-wrap gap-1.5">
          {stack.map((s) => <span class="tag">{s}</span>)}
        </div>

        <div class="mt-5 space-y-2.5 border-t border-line pt-4">
          <a href="mailto:afghanekapangestu@gmail.com" class="mono-meta block truncate text-text-2 no-underline transition-colors hover:text-accent">
            afghanekapangestu@gmail.com
          </a>
          <div class="flex gap-4">
            <a href="https://github.com/afg2002" target="_blank" rel="noopener" class="mono-meta no-underline transition-colors hover:text-accent">GitHub</a>
            <a href="https://www.linkedin.com/in/afghan-eka-pangestu/" target="_blank" rel="noopener" class="mono-meta no-underline transition-colors hover:text-accent">LinkedIn</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
