<button
  id="scroll-top-btn"
  class="pointer-events-none fixed bottom-5 right-5 z-50 flex h-11 w-11 translate-y-3 items-center justify-center border-2 border-ink bg-acid text-ink opacity-0 shadow-brut-sm transition-all duration-300 hover:-translate-x-0.5 hover:-translate-y-0.5 md:bottom-8 md:right-8"
  aria-label="Scroll to top"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="square" d="M12 20V4m0 0l-6 6m6-6l6 6" />
  </svg>
</button>

<script>
  const btn = document.getElementById("scroll-top-btn");
  if (btn) {
    const toggle = () => {
      if (window.scrollY > 500) {
        btn.classList.remove("opacity-0", "translate-y-3", "pointer-events-none");
      } else {
        btn.classList.add("opacity-0", "translate-y-3", "pointer-events-none");
      }
    };
    window.addEventListener("scroll", toggle, { passive: true });
    toggle();
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
