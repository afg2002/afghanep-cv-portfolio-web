<button
  id="scroll-top-btn"
  class="pointer-events-none fixed bottom-5 right-5 z-40 flex h-10 w-10 translate-y-2 items-center justify-center rounded-[2px] border border-line bg-surface text-muted opacity-0 shadow-sm transition-all duration-300 hover:border-line-strong hover:text-text md:bottom-8 md:right-8"
  aria-label="Scroll to top"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 20V5m0 0l-6 6m6-6l6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const btn = document.getElementById("scroll-top-btn");
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 600;
      btn.classList.toggle("opacity-0", !show);
      btn.classList.toggle("translate-y-2", !show);
      btn.classList.toggle("pointer-events-none", !show);
    };
    window.addEventListener("scroll", toggle, { passive: true });
    toggle();
    btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  }
</script>
