---
const certs = [
  { title: "Pemrograman Go-Lang: Pemula sampai Mahir", issuer: "Udemy", year: "2022" },
  { title: "Kampus Merdeka — MSIB Batch 6", issuer: "PT BTPN Syariah Tbk", year: "2024" },
  { title: "Theoretical Understanding of HTML", issuer: "Sololearn", year: "2018" },
  { title: "Theoretical Understanding of PHP", issuer: "Sololearn", year: "2018" },
];
---

<section id="certifications" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="06">Credentials</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">Certifications</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        Formal certificates alongside the work itself — the projects are the real proof.
      </p>
    </div>

    <ul class="grid grid-cols-1 border-t border-line sm:grid-cols-2">
      {certs.map((c, i) => (
        <li
          class:list={[
            "border-b border-line py-4",
            i % 2 === 1 && "sm:border-l sm:border-line sm:pl-6",
            i % 2 === 0 && "sm:pr-6",
          ]}
        >
          <div class="mb-1 flex items-baseline justify-between gap-3">
            <h3 class="text-[13.5px] font-medium leading-snug text-text">{c.title}</h3>
            <span class="mono-meta shrink-0">{c.year}</span>
          </div>
          <p class="mono-meta">{c.issuer}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
