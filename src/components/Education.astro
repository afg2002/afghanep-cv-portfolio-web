---
const education = [
  {
    school: "Universitas Indraprasta PGRI",
    degree: "Bachelor of Informatics Engineering",
    period: "2020 — 2024",
    scoreLabel: "GPA",
    score: "3.62 / 4.00",
    notes: [
      "Recommended as Laboratory Assistant",
      "Participated in MSIB Batch 6",
      "Published journal on DSS for gastric disease diagnosis using Forward Chaining",
    ],
  },
  {
    school: "SMK Negeri 1 Cibinong",
    degree: "Software Engineering",
    period: "2017 — 2020",
    scoreLabel: "Score",
    score: "84 / 100",
    notes: [
      "Earned LSP certification in Software Development with 23 competency units",
    ],
  },
];
---

<section id="education" class="section">
  <div class="u-container">
    <div class="section-head">
      <div>
        <p class="index-label mb-2" data-index="05">Education</p>
        <h2 class="heading text-[clamp(1.75rem,4.5vw,2.75rem)]">Foundations</h2>
      </div>
      <p class="mono-meta max-w-[34ch] leading-relaxed">
        Formal training in software engineering, then applied in production systems.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 md:gap-6">
      {education.map((ed) => (
        <article class="border border-line bg-surface p-5 md:p-6">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <span class="mono-meta">{ed.period}</span>
            <span class="tag tag-accent">{ed.scoreLabel} {ed.score}</span>
          </div>

          <h3 class="heading mb-1 text-[16px] text-text md:text-[18px]">{ed.school}</h3>
          <p class="mb-4 text-[13px] text-muted">{ed.degree}</p>

          <ul class="space-y-1.5 border-t border-line pt-4">
            {ed.notes.map((n) => (
              <li class="relative pl-4 text-[13px] leading-relaxed text-text-2">
                <span class="absolute left-0 top-[0.62em] h-[3px] w-[3px] rounded-full bg-accent" aria-hidden="true"></span>
                {n}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
