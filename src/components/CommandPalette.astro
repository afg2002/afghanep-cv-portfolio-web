---
---

<div
  id="cmd-palette"
  class="fixed inset-0 z-[200] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div id="cmd-backdrop" class="absolute inset-0 bg-black/55 backdrop-blur-[2px]"></div>

  <div class="relative mx-auto mt-[8vh] w-full max-w-2xl px-4 md:mt-[10vh]">
    <div class="overflow-hidden border border-line-strong bg-bg shadow-2xl shadow-black/40">
      <!-- Search input -->
      <div class="flex items-center gap-3 border-b border-line px-4 py-3.5">
        <svg class="h-4 w-4 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-3.8-3.8" stroke-linecap="round" />
        </svg>
        <input
          id="cmd-input"
          type="search"
          role="combobox"
          aria-expanded="true"
          aria-controls="cmd-results"
          aria-autocomplete="list"
          placeholder="Search articles and pages…"
          class="min-w-0 flex-1 bg-transparent text-[14px] text-text placeholder:text-muted focus:outline-none [&::-webkit-search-cancel-button]:hidden"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search articles and pages"
        />
        <kbd class="hidden rounded-[2px] border border-line bg-surface px-1.5 py-0.5 font-mono text-[10px] uppercase text-muted sm:block">esc</kbd>
      </div>

      <div id="cmd-results" class="max-h-[60vh] overflow-y-auto overscroll-contain">
        <!-- Idle state: quick links -->
        <div id="cmd-idle">
          <div class="px-4 pb-1 pt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-muted/70">Jump to</div>
          <a href="/#work" data-cmd="work projects" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Work</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">01</span>
          </a>
          <a href="/#stack" data-cmd="stack skills" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Stack</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">02</span>
          </a>
          <a href="/#experience" data-cmd="experience history" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Experience</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">03</span>
          </a>
          <a href="/#about" data-cmd="about me" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">About</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">04</span>
          </a>
          <a href="/#contact" data-cmd="contact email hire" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Contact</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">07</span>
          </a>
          <a href="/blog" data-cmd="blog writing articles posts" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Writing</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">blog</span>
          </a>

          <div class="border-t border-line px-4 pb-1 pt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-muted/70">Actions</div>
          <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" data-cmd="cv resume download" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Download CV</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">ctrl+d</span>
          </a>
          <a href="https://github.com/afg2002" target="_blank" rel="noopener" data-cmd="github code" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">GitHub</span>
            <span class="ml-auto font-mono text-[10px] uppercase text-muted/60">ctrl+g</span>
          </a>
          <a href="https://www.linkedin.com/in/afghan-eka-pangestu/" target="_blank" rel="noopener" data-cmd="linkedin" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">LinkedIn</span>
          </a>
          <a href="mailto:afghanekapangestu@gmail.com" data-cmd="email mail contact" class="cmd-item flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface">
            <span class="text-[13px] text-text">Send an email</span>
          </a>
        </div>

        <!-- Search results -->
        <div id="cmd-search-results" class="hidden" role="listbox" aria-label="Search results"></div>

        <!-- Loading -->
        <div id="cmd-loading" class="hidden items-center justify-center gap-3 py-10">
          <span class="h-4 w-4 animate-spin rounded-full border-2 border-line-strong border-t-accent"></span>
          <span class="font-mono text-[11px] text-muted">Searching…</span>
        </div>

        <!-- Empty -->
        <div id="cmd-empty" class="hidden px-4 py-10 text-center">
          <p class="font-mono text-[11px] text-muted">No results found</p>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-line bg-surface px-4 py-2 font-mono text-[10px] uppercase tracking-[0.08em] text-muted">
        <span id="cmd-footer-left">Jump to</span>
        <span class="hidden sm:inline">↑↓ move · ↵ open · esc close</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { searchSite, loadPagefind, type SearchHit } from "../lib/search";

  (function () {
    const palette = document.getElementById("cmd-palette")!;
    const input = document.getElementById("cmd-input") as HTMLInputElement | null;
    const backdrop = document.getElementById("cmd-backdrop");
    const idle = document.getElementById("cmd-idle");
    const resultsEl = document.getElementById("cmd-search-results");
    const loadingEl = document.getElementById("cmd-loading");
    const emptyEl = document.getElementById("cmd-empty");
    const footerLeft = document.getElementById("cmd-footer-left");

    if (!palette || !input) return;

    const escapeHtml = (text: string) => {
      const div = document.createElement("div");
      div.textContent = text || "";
      return div.innerHTML;
    };

    const highlight = (text: string, query: string) => {
      const safeText = escapeHtml(text);
      const terms = query.trim().split(/\s+/).filter(Boolean);
      if (!terms.length) return safeText;
      const pattern = terms
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
        .join("|");
      return safeText.replace(
        new RegExp(`(${pattern})`, "gi"),
        '<mark class="bg-accent-soft text-accent rounded-[2px] px-0.5">$1</mark>'
      );
    };

    // ── Open / close ────────────────────────────────────────────
    function togglePalette(force?: boolean) {
      const isHidden = palette.classList.contains("hidden");
      const open = force ?? isHidden;
      palette.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
      if (open) {
        input.value = "";
        renderIdle();
        input.focus();
      }
    }

    // ── States ──────────────────────────────────────────────────
    function renderIdle() {
      idle?.classList.remove("hidden");
      resultsEl?.classList.add("hidden");
      loadingEl?.classList.add("hidden");
      emptyEl?.classList.add("hidden");
      if (footerLeft) footerLeft.textContent = "Jump to";
      document.querySelectorAll("#cmd-idle .cmd-item").forEach((i) => i.classList.remove("hidden"));
      setCursor(-1);
    }

    function renderLoading() {
      idle?.classList.add("hidden");
      resultsEl?.classList.add("hidden");
      loadingEl?.classList.remove("hidden");
      loadingEl?.classList.add("flex");
      emptyEl?.classList.add("hidden");
    }

    function renderEmpty(query: string) {
      idle?.classList.add("hidden");
      resultsEl?.classList.add("hidden");
      loadingEl?.classList.add("hidden");
      emptyEl?.classList.remove("hidden");
      if (footerLeft) footerLeft.textContent = `No results for “${query}”`;
    }

    function renderResults(hits: SearchHit[], query: string) {
      idle?.classList.add("hidden");
      loadingEl?.classList.add("hidden");
      emptyEl?.classList.add("hidden");
      resultsEl?.classList.remove("hidden");
      if (!resultsEl) return;

      resultsEl.innerHTML = "";

      // Group posts above pages — articles are what people search for.
      const groups: Array<{ label: string; kind: SearchHit["kind"] }> = [
        { label: "Writing", kind: "post" },
        { label: "Pages", kind: "page" },
      ];

      for (const group of groups) {
        const items = hits.filter((h) => h.kind === group.kind);
        if (!items.length) continue;

        const heading = document.createElement("div");
        heading.className =
          "px-4 pb-1 pt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-muted/70";
        heading.textContent = group.label;
        resultsEl.appendChild(heading);

        for (const hit of items) {
          const a = document.createElement("a");
          a.href = hit.url;
          a.className =
            "cmd-item flex items-start gap-3 border-l-2 border-transparent px-4 py-2.5 no-underline transition-colors hover:border-accent hover:bg-surface";
          a.setAttribute("role", "option");
          a.innerHTML =
            `<svg class="mt-1 h-3.5 w-3.5 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">` +
            (group.kind === "post"
              ? `<path d="M6 3h9l4 4v14H6z" stroke-linejoin="round"/><path d="M14 3v5h5" stroke-linejoin="round"/>`
              : `<path d="M4 5h16v14H4z" stroke-linejoin="round"/><path d="M4 9h16"/>`) +
            `</svg>` +
            `<div class="min-w-0 flex-1">` +
            `<p class="text-[13px] font-medium leading-snug text-text">${highlight(hit.title, query)}</p>` +
            (hit.excerpt
              ? `<p class="mt-1 line-clamp-2 text-[11.5px] leading-relaxed text-muted">${highlight(hit.excerpt, query)}</p>`
              : "") +
            `</div>` +
            `<svg class="mt-1 h-3 w-3 shrink-0 text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
          resultsEl.appendChild(a);
        }
      }

      if (footerLeft) {
        footerLeft.textContent = `${hits.length} result${hits.length === 1 ? "" : "s"} for “${query}”`;
      }
      setCursor(-1);
    }

    // ── Query handling ──────────────────────────────────────────
    let requestId = 0;

    async function runSearch(query: string) {
      const id = ++requestId;

      if (query.length < 2) {
        // Short queries: filter the static quick-links instead of hitting the index.
        let visible = false;
        document.querySelectorAll<HTMLElement>("#cmd-idle .cmd-item").forEach((item) => {
          const haystack = `${item.dataset.cmd || ""} ${item.textContent || ""}`.toLowerCase();
          const match = haystack.includes(query.toLowerCase());
          item.classList.toggle("hidden", !match);
          if (match) visible = true;
        });
        idle?.classList.remove("hidden");
        resultsEl?.classList.add("hidden");
        loadingEl?.classList.add("hidden");
        emptyEl?.classList.toggle("hidden", visible);
        return;
      }

      renderLoading();
      const hits = await searchSite(query, 10);
      if (id !== requestId) return; // a newer keystroke won

      if (!hits.length) renderEmpty(query);
      else renderResults(hits, query);
    }

    let debounce: number | undefined;
    input.addEventListener("input", () => {
      const q = input.value.trim();
      window.clearTimeout(debounce);
      if (!q) {
        renderIdle();
        return;
      }
      debounce = window.setTimeout(() => runSearch(q), 140);
    });

    // Preload the index as soon as the palette is first opened.
    let preloaded = false;
    const preload = () => {
      if (preloaded) return;
      preloaded = true;
      loadPagefind();
    };
    input.addEventListener("focus", preload, { once: true });

    // ── Keyboard: cursor over visible items ─────────────────────
    let cursor = -1;

    function visibleItems(): HTMLElement[] {
      const scope = idle && !idle.classList.contains("hidden") ? idle : resultsEl;
      return Array.from(scope?.querySelectorAll<HTMLElement>(".cmd-item") ?? []).filter(
        (el) => !el.classList.contains("hidden")
      );
    }

    function setCursor(next: number) {
      const items = visibleItems();
      items.forEach((el) => {
        el.classList.remove("bg-surface", "border-accent");
        el.setAttribute("aria-selected", "false");
      });
      cursor = next;
      if (next >= 0 && items[next]) {
        items[next].classList.add("bg-surface", "border-accent");
        items[next].setAttribute("aria-selected", "true");
        items[next].scrollIntoView({ block: "nearest" });
      }
    }

    backdrop?.addEventListener("click", () => togglePalette(false));

    document.addEventListener("keydown", (e) => {
      const open = !palette.classList.contains("hidden");

      if (e.key === "Escape" && open) {
        togglePalette(false);
        return;
      }

      if (open) {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          preload();
          const items = visibleItems();
          if (!items.length) return;
          setCursor(
            e.key === "ArrowDown"
              ? (cursor + 1) % items.length
              : (cursor - 1 + items.length) % items.length
          );
          return;
        }
        if (e.key === "Enter") {
          const items = visibleItems();
          if (cursor >= 0 && items[cursor]) {
            e.preventDefault();
            items[cursor].click();
          }
          return;
        }
      }

      if (!(e.ctrlKey || e.metaKey)) return;
      const k = e.key.toLowerCase();
      if (k === "k") {
        e.preventDefault();
        togglePalette();
      } else if (k === "h") {
        e.preventDefault();
        window.location.href = "/#home";
      } else if (k === "b") {
        e.preventDefault();
        window.location.href = "/blog";
      } else if (k === "g") {
        e.preventDefault();
        window.open("https://github.com/afg2002", "_blank");
      } else if (k === "d") {
        e.preventDefault();
        window.open("/cv-afghan-eka-pangestu.pdf", "_blank");
      }
    });

    // Exposed for the header buttons.
    (window as any).__toggleSearch = () => {
      preload();
      togglePalette();
    };
  })();
</script>
