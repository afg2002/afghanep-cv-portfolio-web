---
const isHome = Astro.url.pathname === "/";
const base = isHome ? "" : "/";
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${base}#work`, label: "Work", section: "work" },
  { href: `${base}#stack`, label: "Stack", section: "stack" },
  { href: `${base}#experience`, label: "Experience", section: "experience" },
  { href: `${base}#about`, label: "About", section: "about" },
  { href: `${base}#contact`, label: "Contact", section: "contact" },
];
---

<header
  class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
  data-pagefind-ignore
>
  <nav class="u-container flex h-14 items-center justify-between gap-3 md:h-16" aria-label="Main navigation">
    <!-- Wordmark -->
    <a href="/" class="group flex items-center gap-2.5 no-underline" aria-label="Afghan Eka Pangestu — home">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-[2px] bg-text font-mono text-[11px] font-medium text-bg transition-colors group-hover:bg-accent group-hover:text-[var(--on-accent)]"
        aria-hidden="true"
      >
        AE
      </span>
      <span class="hidden leading-tight sm:block">
        <span class="block text-[13px] font-semibold tracking-[-0.01em] text-text">Afghan Eka Pangestu</span>
        <span class="block font-mono text-[10px] uppercase tracking-[0.12em] text-muted">Software Developer</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-0.5 lg:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-section={link.section}
            class="nav-link relative block px-2.5 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-muted no-underline transition-colors hover:text-text"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/blog"
          class:list={[
            "block px-2.5 py-2 font-mono text-[11px] uppercase tracking-[0.1em] no-underline transition-colors",
            currentPath.startsWith("/blog") ? "text-text" : "text-muted hover:text-text",
          ]}
        >
          Writing
        </a>
      </li>
    </ul>

    <div class="flex items-center gap-1.5">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-[2px] border border-transparent text-muted transition-colors hover:border-line hover:bg-surface hover:text-text"
        aria-label="Switch theme"
        title="Switch theme"
      >
        <svg id="icon-system" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" stroke-linecap="round" />
        </svg>
        <svg id="icon-light" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke-linecap="round" />
        </svg>
        <svg id="icon-dark" class="hidden h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" stroke-linejoin="round" />
        </svg>
      </button>

      <button
        id="search-btn"
        class="hidden h-9 w-9 items-center justify-center rounded-[2px] border border-transparent text-muted transition-colors hover:border-line hover:bg-surface hover:text-text md:flex"
        aria-label="Search site (Ctrl+K)"
        title="Search (Ctrl+K)"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-3.8-3.8" stroke-linecap="round" />
        </svg>
      </button>

      <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" rel="noopener" class="hidden btn btn-sm md:inline-flex">
        CV
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <!-- Mobile trigger -->
      <button
        id="mobile-menu-btn"
        class="flex h-9 w-9 items-center justify-center rounded-[2px] border border-line text-text lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-4.5 w-4.5" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" stroke-linecap="round" />
        </svg>
        <svg id="menu-icon-close" class="hidden" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-bg lg:hidden"
    style="overscroll-behavior: contain;"
  >
    <ul class="u-container py-3">
      {navLinks.map((link, i) => (
        <li class="border-b border-line/60 last:border-0">
          <a
            href={link.href}
            class="mobile-nav-link flex min-h-[44px] items-center justify-between gap-3 py-3 text-[15px] font-medium text-text no-underline"
          >
            {link.label}
            <span class="font-mono text-[10px] tracking-[0.1em] text-muted">{String(i + 1).padStart(2, "0")}</span>
          </a>
        </li>
      ))}
      <li class="border-b border-line/60">
        <a href="/blog" class="mobile-nav-link flex min-h-[44px] items-center justify-between gap-3 py-3 text-[15px] font-medium text-text no-underline">
          Writing
          <span class="font-mono text-[10px] tracking-[0.1em] text-muted">06</span>
        </a>
      </li>
      <li class="grid grid-cols-2 gap-2 pt-3">
        <button
          id="search-btn-mobile"
          class="flex min-h-[44px] items-center justify-center gap-2 border border-line px-3 font-mono text-[11px] uppercase tracking-[0.08em] text-text"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-3.8-3.8" stroke-linecap="round" />
          </svg>
          Search
        </button>
        <a
          href="/cv-afghan-eka-pangestu.pdf"
          target="_blank"
          rel="noopener"
          class="mobile-nav-link flex min-h-[44px] items-center justify-center gap-2 bg-text px-3 font-mono text-[11px] uppercase tracking-[0.08em] text-bg no-underline"
        >
          CV
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // ── Mobile menu ──
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  const closeMenu = () => {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
  };

  btn?.addEventListener("click", () => {
    const willOpen = menu?.classList.contains("hidden") ?? false;
    if (willOpen) {
      menu?.classList.remove("hidden");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      btn.setAttribute("aria-expanded", "true");
    } else {
      closeMenu();
    }
  });

  menu?.querySelectorAll(".mobile-nav-link").forEach((l) => l.addEventListener("click", closeMenu));

  document.getElementById("search-btn")?.addEventListener("click", () => (window as any).__toggleSearch?.());
  document.getElementById("search-btn-mobile")?.addEventListener("click", () => {
    closeMenu();
    (window as any).__toggleSearch?.();
  });

  // ── Theme toggle: system → light → dark ──
  const themeBtn = document.getElementById("theme-toggle");
  const icons = {
    system: document.getElementById("icon-system"),
    light: document.getElementById("icon-light"),
    dark: document.getElementById("icon-dark"),
  };
  const labels = {
    system: "Theme: system (click for light)",
    light: "Theme: light (click for dark)",
    dark: "Theme: dark (click for system)",
  };
  const order = ["system", "light", "dark"] as const;
  const root = document.documentElement;

  const applyTheme = (mode: "system" | "light" | "dark") => {
    const dark = mode === "dark" || (mode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    root.classList.toggle("dark", dark);
    (Object.keys(icons) as Array<keyof typeof icons>).forEach((k) => {
      icons[k]?.classList.toggle("hidden", k !== mode);
    });
    if (themeBtn) {
      themeBtn.setAttribute("aria-label", labels[mode]);
      themeBtn.setAttribute("title", labels[mode]);
    }
  };

  let current: "system" | "light" | "dark" = (localStorage.getItem("theme") as any) || "dark";
  if (!order.includes(current)) current = "dark";
  applyTheme(current);

  themeBtn?.addEventListener("click", () => {
    current = order[(order.indexOf(current) + 1) % order.length];
    localStorage.setItem("theme", current);
    applyTheme(current);
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (current === "system") applyTheme("system");
  });

  // ── Scroll spy ──
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const sections = spyLinks
    .map((l) => document.getElementById(l.dataset.section || ""))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length && "IntersectionObserver" in window) {
    const ratios = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => ratios.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        let best: string | null = null;
        let bestRatio = 0;
        ratios.forEach((r, id) => {
          if (r > bestRatio) {
            bestRatio = r;
            best = id;
          }
        });
        if (best) {
          spyLinks.forEach((l) => {
            const active = l.dataset.section === best;
            l.classList.toggle("text-text", active);
            l.classList.toggle("text-muted", !active);
          });
        }
      },
      { rootMargin: "-15% 0px -60% 0px", threshold: [0.05, 0.25, 0.5] }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
