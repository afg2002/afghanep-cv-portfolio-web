---
const isHome = Astro.url.pathname === "/";
const base = isHome ? "" : "/";

const navLinks = [
  { href: `${base}#work`, label: "Work" },
  { href: `${base}#skills`, label: "Stack" },
  { href: `${base}#experience`, label: "Experience" },
  { href: `${base}#about`, label: "About" },
  { href: `${base}#contact`, label: "Contact" },
];
---

<header
  class="sticky top-0 z-50 bg-paper/95 backdrop-blur-sm border-b-2 border-ink"
  data-pagefind-ignore
>
  <nav class="u-container flex h-16 items-center justify-between gap-4 md:h-[72px]" aria-label="Main navigation">
    <!-- Logo -->
    <a
      href="/"
      class="group flex items-center gap-2.5 no-underline"
      aria-label="Afghan Eka Pangestu — home"
    >
      <span
        class="flex h-9 w-9 items-center justify-center border-2 border-ink bg-acid font-display text-[13px] leading-none text-ink shadow-brut-xs transition-transform duration-150 group-hover:-translate-x-0.5 group-hover:-translate-y-0.5 md:h-10 md:w-10 md:text-sm"
      >
        AEP
      </span>
      <span class="hidden leading-[1.05] sm:block">
        <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-ink-3">Afghan Eka</span>
        <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-ink">Pangestu</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link group px-3 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-ink-3 no-underline transition-colors hover:text-ink"
            data-section={link.href.split("#")[1]}
          >
            <span class="block border-b-2 border-transparent pb-px transition-colors group-hover:border-ink">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="search-btn"
        class="hidden h-9 w-9 items-center justify-center border-2 border-ink bg-paper text-ink transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-acid hover:shadow-brut-xs md:flex"
        aria-label="Search site (Ctrl+K)"
        title="Search (Ctrl+K)"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path stroke-linecap="square" d="M20 20l-3.6-3.6" />
        </svg>
      </button>

      <a href="/blog" class="hidden md:inline-flex btn btn-sm btn-ink">
        Writing
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M7 17L17 7M9 7h8v8" />
        </svg>
      </a>

      <a href="/cv-afghan-eka-pangestu.pdf" target="_blank" rel="noopener" class="hidden btn btn-sm btn-acid lg:inline-flex">
        CV
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" />
        </svg>
      </a>

      <!-- Mobile trigger -->
      <button
        id="mobile-menu-btn"
        class="flex h-9 w-9 items-center justify-center border-2 border-ink bg-acid text-ink lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t-2 border-ink bg-paper lg:hidden">
    <ul class="u-container grid grid-cols-2 gap-2 py-4">
      {navLinks.map((link, i) => (
        <li class={i === navLinks.length - 1 ? "col-span-2" : ""}>
          <a
            href={link.href}
            class="mobile-nav-link flex items-center border-2 border-ink bg-paper px-3 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink no-underline transition-colors hover:bg-acid"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="col-span-2 grid grid-cols-2 gap-2 pt-2">
        <button
          id="search-btn-mobile"
          class="flex items-center justify-center gap-1.5 border-2 border-ink bg-paper px-3 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-ink transition-colors hover:bg-acid"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path stroke-linecap="square" d="M20 20l-3.6-3.6" />
          </svg>
          Search
        </button>
        <a
          href="/blog"
          class="mobile-nav-link flex items-center justify-center gap-1.5 border-2 border-ink bg-ink px-3 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-paper no-underline"
        >
          Writing
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const links = menu?.querySelectorAll(".mobile-nav-link") ?? [];

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    btn.setAttribute("aria-expanded", String(!isOpen));
  });

  links.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    });
  });

  document.getElementById("search-btn")?.addEventListener("click", () => (window as any).__toggleSearch?.());
  document.getElementById("search-btn-mobile")?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
    (window as any).__toggleSearch?.();
  });

  // ── Scroll spy: highlight the section currently in view ──
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const sections = spyLinks
    .map((l) => document.getElementById(l.dataset.section || ""))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActive = (id: string | null) => {
    spyLinks.forEach((l) => {
      const active = l.dataset.section === id;
      l.classList.toggle("text-ink", active);
      l.classList.toggle("text-ink-3", !active);
      const underline = l.querySelector("span");
      underline?.classList.toggle("border-ink", active);
      underline?.classList.toggle("border-transparent", !active);
    });
  };

  if (sections.length && "IntersectionObserver" in window) {
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        let best: string | null = null;
        let bestRatio = 0;
        visible.forEach((ratio, id) => {
          if (ratio > bestRatio) {
            bestRatio = ratio;
            best = id;
          }
        });
        if (best) setActive(best);
      },
      { rootMargin: "-20% 0px -55% 0px", threshold: [0.05, 0.25, 0.5] }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
